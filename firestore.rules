rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isPartner() {
      return isAuthenticated() && (getUserRole() == 'partner' || getUserRole() == 'admin');
    }

    // 1. Users collection
    // Students can read/write their own profile; nobody can escalate role to 'admin' without admin privileges
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role in ['student', 'partner'];
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }

    // 2. Meals collection
    // Public visitors can read available meals; only admins & approved partners can modify
    match /meals/{mealId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. Kitchens collection
    // Public visitors can read approved kitchens; owners & admins can update
    match /kitchens/{kitchenId} {
      allow read: if resource.data.approvalStatus == 'approved' || isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    // 4. Subscriptions collection
    // Students read/create their own subscription; admins manage all
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 5. Orders collection (WhatsApp enquiries)
    // Students create and read their own orders; admins read and manage all
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Skip requests collection
    // Students create and inspect their own skip requests; admins can approve/reject
    match /skipRequests/{skipId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Partner applications
    // Anyone can apply (create); only admins can read and update status
    match /partnerApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}

